# Salin berkas ini menjadi `.env` lalu isi nilainya.
# JANGAN menaruh berkas .env yang sudah berisi kredensial sungguhan ke dalam repositori.

# ---------------------------------------------------------------------------
# Database (wajib) — PostgreSQL atau Neon
# ---------------------------------------------------------------------------
# Contoh Neon (pakai host "-pooler" bila berjalan di lingkungan serverless):
# DATABASE_URL=postgresql://nama_user:KATA_SANDI@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/nama_db?sslmode=require
# Contoh PostgreSQL lokal:
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# ---------------------------------------------------------------------------
# Driver koneksi (opsional)
# ---------------------------------------------------------------------------
# Otomatis: "neon" bila host DATABASE_URL mengandung .neon.tech, selain itu node-postgres.
# Isi "neon" untuk memaksa driver HTTP serverless @neondatabase/serverless,
# atau "node-postgres" untuk memaksa koneksi TCP lewat pg.Pool.
# DATABASE_DRIVER=neon

# ---------------------------------------------------------------------------
# Seed data contoh (opsional)
# ---------------------------------------------------------------------------
# Saat server dinyalakan, Rotanami memastikan katalog contoh + akun contoh tersedia.
# Setel "false" bila Anda tidak menginginkan data contoh sama sekali.
SEED_DEMO_DATA=true

# ---------------------------------------------------------------------------
# Lainnya (opsional)
# ---------------------------------------------------------------------------
# APP_URL dipakai untuk pesan/log saja; cookie sesi tetap HttpOnly + SameSite=Lax.
# APP_URL=http://localhost:3000
